@baseUrl = http://localhost:3000
# Substitua no cliente HTTP pelo valor de ADMIN_API_TOKEN do processo.
@adminToken = TOKEN_ADMINISTRATIVO_DO_AMBIENTE

### Checkout - sucesso
POST {{baseUrl}}/api/checkout
Content-Type: application/json

{
  "usr": "Guilherme",
